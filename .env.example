# ---------------------------------------------------------------------------
# Workshop credentials. Copy to .env and fill in from your workshop card.
#   cp .env.example .env
# .env is gitignored -- never commit it.
# ---------------------------------------------------------------------------

# Your Civo API key.  Get one at https://dashboard.civo.com/security
CIVO_API_KEY=

# Civo region to create your cluster in. Pick the one nearest the venue.
#   LON1 (London) | FRA1 (Frankfurt) | NYC1 (New York) | PHX1 (Phoenix)
CIVO_REGION=LON1

# Name for your cluster. Change this to something unique -- your first name is
# fine. Everyone is creating clusters in the same account region.
CLUSTER_NAME=kagent-workshop

# Cluster size. 2 x g4s.kube.medium is enough for kagent + a few agents.
CIVO_NODE_SIZE=g4s.kube.medium
CIVO_NODE_COUNT=2

# ---------------------------------------------------------------------------
# relax.ai -- the LLM backing your agents. OpenAI-compatible API.
# ---------------------------------------------------------------------------
# This key is yours -- it is not shared with other attendees.
RELAX_API_KEY=
RELAX_BASE_URL=https://api.relax.ai/v1
# Model must support tool/function calling -- kagent agents are a tool loop.
# All four relax.ai chat models pass scripts/probe-relax.py; this one is the
# fastest, which matters when you are watching it think on a projector.
RELAX_MODEL=DeepSeek-V4-Pro

# ---------------------------------------------------------------------------
# The shared observability hub. This is a cluster the instructor runs, holding
# 7 days of logs from a fleet of (deliberately misbehaving) applications.
# Your agent queries it over MCP.
# ---------------------------------------------------------------------------
# The hub stays up until 2026-10-22. After that, see docs/AFTER.md for how to
# run the same stack in your own cluster.
MCP_ENDPOINT=
MCP_TOKEN=

# ---------------------------------------------------------------------------
# Where your daily report CronJob posts its findings.
# Open the workshop hub in a browser, click "Get my code", and paste the URL
# it gives you here. Your report will appear on that page within seconds.
# Leave blank to log the report to stdout instead.
# ---------------------------------------------------------------------------
REPORT_WEBHOOK_URL=
