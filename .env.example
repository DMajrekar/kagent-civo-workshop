# ---------------------------------------------------------------------------
# Instructor credentials for building the hub.
#
# Players need none of this: they join from a phone with an email address.
#
#   cp .env.example .env     then fill in the two keys below
#
# .env is gitignored -- never commit it.
# ---------------------------------------------------------------------------

# Your Civo API key.  Get one at https://dashboard.civo.com/security
CIVO_API_KEY=

# Civo region for the hub. Pick the one nearest the venue: every player is on
# mobile data, so the round trip matters more than usual.
#   LON1 (London) | FRA1 (Frankfurt) | NYC1 (New York) | PHX1 (Phoenix)
CIVO_REGION=LON1

# ---------------------------------------------------------------------------
# relax.ai -- the model behind every agent. OpenAI-compatible API.
# ---------------------------------------------------------------------------
# One key serves the whole room, so its rate limit is the room's rate limit.
# Ask the relax.ai team what that limit is before the day (docs/CAPACITY.md).
RELAX_API_KEY=
RELAX_BASE_URL=https://api.relax.ai/v1
# Must support tool calling. See docs/DEMO-PROMPTS.md for why this one.
RELAX_MODEL=DeepSeek-V41-Flash

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# A domain you control, with a wildcard pointed at the hub's ingress. Without
# it the hub uses sslip.io names, which work but are ugly in an address bar.
# HUB_DOMAIN=workshop.example.com

# Where Let's Encrypt sends expiry notices.
# ACME_EMAIL=you@example.com

# Seconds for round one (Grafana) and round two (kagent).
# ROUND_SECONDS=600
# ROUND2_SECONDS=900

# The line shown under the email box on the join page. Say what you will
# actually do with the address.
# JOIN_NOTICE=Your email identifies you in this session. The scoreboard shows a generated handle, never your email.
